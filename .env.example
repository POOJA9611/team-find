# ==============================================================================
# Student Project Finder & Originality Checker - Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=False

# Application Session Security Key
SECRET_KEY=your_secure_secret_key_here

# MySQL Database Configuration
# Supported DB_TYPE values:
#   - "mysql"  : Connects to MySQL using PyMySQL (recommended for production)
#   - "sqlite" : Uses local SQLite fallback file (student_project_finder.sqlite)
DB_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=student_project_finder
